{
  "name": "hysterianode-subscription-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "types": "wrangler types",
    "check": "wrangler types --check && tsc --noEmit && node --check public/app.js",
    "test": "node --test test/*.test.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.1"
  }
}
